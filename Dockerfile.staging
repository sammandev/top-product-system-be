# syntax=docker/dockerfile:1.7
# Staging Dockerfile with Hot Reload Support
# Multi-stage build to reduce image size and keep dependency layers cacheable.

FROM python:3.13-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Build dependencies (removed in final image)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install the build tool and dependency metadata before application source.
# Source edits therefore do not invalidate the expensive dependency layer.
RUN pip install --no-cache-dir uv==0.11.8
COPY pyproject.toml uv.lock ./

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-dev --no-install-project --format requirements.txt \
        --output-file /tmp/requirements.txt && \
    uv pip install --python /opt/venv/bin/python \
        --requirements /tmp/requirements.txt

# Install the local package after dependencies so this layer stays cheap to rebuild.
COPY src/ ./src/
RUN uv pip install --python /opt/venv/bin/python --no-deps .


FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Runtime dependencies only
# postgresql-client provides pg_dump and psql for backup/restore scripts
# netcat-traditional for connectivity checks
RUN apt-get update && apt-get install -y \
    libpq5 \
    postgresql-client \
    netcat-traditional \
    curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create necessary directories
RUN mkdir -p /app/uploads /app/logs /app/alembic /app/scripts /app/data

# Expose port
EXPOSE 7070

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://127.0.0.1:7070/health || exit 1

# Default command (will be overridden in docker-compose for hot reload)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7070", "--reload", "--reload-dir", "/app/src"]
