# App Configuration
APP_NAME=<application_name>
DEBUG=<True/False>

# Database configuration
DB_USER=<username>
DB_PASSWORD=<password>
DB_PASS=<password>
DB_HOST=<host>
DB_PORT=<port>
DB_NAME=<database>
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT=10
# Local SQLite dev example:
# DATABASE_URL=sqlite:///./local-dev.db

# Redis configuration
REDIS_URL=redis://localhost:6379/0  # Redis connection URL (leave unset to disable caching)
REDIS_DUT_CACHE_TTL=300              # Default cache TTL in seconds (5 minutes)
ENABLE_DUT_CACHE=true                # Enable/disable Redis caching for DUT endpoints

# JWT configuration
# random 32-bytes | run: `openssl rand -hex 32`
JWT_SECRET=<random_32bytes>
JWT_ALG=<HS256/RS256/ES256/etc>
JWT_TTL=<int_ttl>  # ttl in seconds
JWT_REFRESH_TTL=<int_ttl>   # ttl in seconds

# Mock auth for local frontend development
ENABLE_MOCK_AUTH=false
SEED_MOCK_AUTH_USERS=false

# Argon2 tuning (low CPU/RAM; adjust if needed)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=32768      # KiB (32 MB)
ARGON2_PARALLELISM=2

# ASTPARSER Configuration
ASTPARSER_API_KEY=changeme_api_key
ASTPARSER_ADMIN_KEY=changeme_admin_key
UPLOAD_TTL_SECONDS=<int_ttl>

# Base URL used by tests (override by exporting ASTPARSER_TEST_BASE in the shell)
ASTPARSER_TEST_BASE=<http://test_base_url>
UPLOAD_PERSIST=<0/1>

# External API Configuration
DUT_API_BASE_URL=<http://intranet_dut_api_url>
DUT_API_USERNAME=<username>
DUT_API_PASSWORD=<password>
DUT_API_TIMEOUT=30
DUT_API_CONNECT_TIMEOUT=5
DUT_API_POOL_TIMEOUT=5
DUT_API_MAX_CONNECTIONS=100
DUT_API_MAX_KEEPALIVE_CONNECTIONS=20
RUN_DUT_API_TESTS=<0/1>


# iPLAS API Configuration
IPLAS_API_PTB_BASE_URL=<http://external_ptb_api_url>
IPLAS_API_PSZ_BASE_URL=<http://external_psz_api_url>
IPLAS_API_PXD_BASE_URL=<http://external_pxd_api_url>
IPLAS_API_PVN_BASE_URL=<http://external_pvn_api_url>
IPLAS_API_PTY_BASE_URL=<http://external_pty_api_url>
IPLAS_V1_API_VERSION=/api/v1
IPLAS_V2_API_VERSION=/api/v2
IPLAS_API_PORT=<port_number>
IPLAS_API_TIMEOUT=180
IPLAS_SERVER_TIME_TIMEOUT=3
IPLAS_SERVER_TIME_CACHE_TTL=5
IPLAS_REDIS_HEALTH_CHECK_INTERVAL=30
IPLAS_REDIS_CONNECT_TIMEOUT=1
IPLAS_CACHE_TTL_EMPTY=15
IPLAS_DEVICE_DENSITY_THRESHOLD=10
IPLAS_MAX_PARALLEL_REQUESTS=8
DUT_CATALOG_MAX_PARALLEL_REQUESTS=8
IPLAS_API_TOKEN_PTB=<token_string>
IPLAS_API_TOKEN_PSZ=<token_string>
IPLAS_API_TOKEN_PXD=<token_string>
IPLAS_API_TOKEN_PVN=<token_string>
IPLAS_API_TOKEN_PTY=<token_string>

# SFISTSP Web Service Configuration
SFISTSP_API_BASE_URL=<http://sfistsp_host>
SFIS_DEFAULT_PROGRAM_ID=<program_id>
SFIS_DEFAULT_PROGRAM_PASSWORD=<program_password>
SFISTSP_API_TIMEOUT=15
SFISTSP_MAX_CONNECTIONS=20
SFISTSP_MAX_KEEPALIVE_CONNECTIONS=10
